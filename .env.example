SQLSERVER_SA_PASSWORD=Your_strong_password123
SQLSERVER_PORT=1433
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
API_PORT=5000
AI_SERVICE_PORT=8000
WEB_PORT=5173

# Backend runtime
JWT_SECRET=change-this-production-secret-at-least-32-characters
API_CONNECTION_STRING=Server=sqlserver;Database=AdmissionsAiSystem;User Id=sa;Password=Your_strong_password123;TrustServerCertificate=True

# AI / vector
QDRANT_URL=http://qdrant:6333
LOCAL_VECTOR_STORE=/app/storage/local_vectors.json
TESSERACT_CMD=/usr/bin/tesseract
TESSDATA_DIR=/usr/share/tesseract-ocr/5/tessdata

# Optional OpenAI-compatible LLM generation.
# Leave disabled to use deterministic extractive RAG fallback.
# Local Ollama example outside Docker:
# LLM_ENABLED=true
# LLM_BASE_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=qwen2.5:3b
# Docker-to-host Ollama example:
# LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_ENABLED=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45
