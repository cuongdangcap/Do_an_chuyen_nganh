@Admissions.Api_HostAddress = http://localhost:5075
@AccessToken = paste-access-token-here
@RefreshToken = paste-refresh-token-here

GET {{Admissions.Api_HostAddress}}/api/health
Accept: application/json

###

POST {{Admissions.Api_HostAddress}}/api/auth/register-student
Content-Type: application/json

{
  "email": "bit240048@st.cmcu.edu.vn",
  "password": "Student123456!",
  "fullName": "Tai khoan sinh vien do nha truong cap",
  "phone": "0912345678"
}

### Endpoint này phải trả lỗi STUDENT_SELF_REGISTER_DISABLED

###

POST {{Admissions.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "BIT240048@st.cmcu.edu.vn",
  "password": "Student123456!"
}

###

GET {{Admissions.Api_HostAddress}}/api/auth/me
Authorization: Bearer {{AccessToken}}
Accept: application/json

###

GET {{Admissions.Api_HostAddress}}/api/profiles/me
Authorization: Bearer {{AccessToken}}
Accept: application/json

###

POST {{Admissions.Api_HostAddress}}/api/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{RefreshToken}}"
}

###

GET {{Admissions.Api_HostAddress}}/api/admin/users
Authorization: Bearer {{AccessToken}}
Accept: application/json

###
